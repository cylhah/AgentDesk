{
  "name": "agentdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentDesk — agent runtime that runs inside an embedded web container",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx apps/cli/src/index.ts",
    "demo": "tsx apps/cli/src/index.ts run --mock media-01",
    "eval": "tsx apps/cli/src/index.ts eval",
    "ui": "tsx apps/desktop/src/main.ts",
    "ui:electron": "node apps/desktop/electron/launch.cjs",
    "verify": "pnpm build && pnpm test && pnpm eval && pnpm demo",
    "check": "npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^45.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
